//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  OPENING RANGE BREAKOUT — FUTURES · BACKTEST + TRADERSPOST WEBHOOK
// ═══════════════════════════════════════════════════════════════════════════
//  LOGIC
//    1. Opening range is captured from a configurable session window,
//       measured in EXCHANGE time (no timezone offset applied).
//    2. OR high / OR low are drawn for the rest of the trading session,
//       capped at a configurable maximum duration (default 8 hours).
//    3. Entry needs TWO CONSECUTIVE bars closing outside the range, with
//       volume above its moving average by a configurable factor (1.15).
//    4. Optional VWAP and EMA filters, each toggleable so they can be
//       tested independently against the same baseline.
//    5. ATR stop / ATR target, both configurable (default 0.5 / 2.0).
//
//  ALERT SETUP
//    TradingView → Alert → Condition: this strategy
//      • "Order fills only"
//      • Message:  {{strategy.order.alert_message}}
//      • Webhook URL: your TradersPost webhook
//    Keep "Also fire alert() calls" OFF with that setting or every order
//    sends two webhooks.
//
//  TIMEFRAME NOTE
//    The opening range cannot be finer than your chart. A 5-minute OR needs
//    a 5-minute chart; on a 1-hour chart the OR becomes the full first hour.
// ═══════════════════════════════════════════════════════════════════════════

strategy(title                   = "Opening Range Breakout — Futures",
         shorttitle              = "ORB",
         overlay                 = true,
         initial_capital         = 25000,
         currency                = currency.USD,
         default_qty_type        = strategy.fixed,
         default_qty_value       = 1,
         commission_type         = strategy.commission.cash_per_contract,
         commission_value        = 2.50,
         slippage                = 1,
         pyramiding              = 0,
         calc_on_every_tick      = false,
         process_orders_on_close = true,
         max_labels_count        = 500)

// ───────────────────────────────────────────────────────────────────────────
//  1 · INPUTS
// ───────────────────────────────────────────────────────────────────────────
grpD = "Direction"
dirMode = input.string("Both", "Trade direction",
     options = ["Both", "Long only", "Short only"], group = grpD)

grpO = "Opening range (exchange time)"
orSess    = input.session("0930-0935", "OR window",                     group = grpO)
maxOrHrs  = input.float(8.0, "Max OR display (hours)", minval = 0.25, step = 0.25, group = grpO)
onePerSide= input.bool(true, "Only one trade per side per OR",          group = grpO)

grpE = "Entry"
breakBars = input.int(2, "Bars closing outside OR", minval = 1, maxval = 10, group = grpE)

grpV = "Volume filter"
useVol    = input.bool(true, "Require elevated volume",       group = grpV)
volMult   = input.float(1.15, "Volume ≥ average ×", minval = 0.5, step = 0.05, group = grpV)
volLen    = input.int(20, "Volume average length", minval = 1, group = grpV)
volBoth   = input.bool(true, "Apply to both breakout bars",    group = grpV)

grpF = "Trend filters (test individually)"
useVwap = input.bool(true,  "VWAP filter",                  group = grpF)
useEma  = input.bool(false, "EMA filter",                   group = grpF)
emaLen  = input.int(50, "EMA length", minval = 1,           group = grpF)

grpR = "Risk (ATR)"
atrLen       = input.int(14,  "ATR length",                    minval = 1,   group = grpR)
atrSL        = input.float(0.5, "Stop   = ATR ×",              minval = 0.05, step = 0.05, group = grpR)
atrTP        = input.float(2.0, "Target = ATR ×",              minval = 0.05, step = 0.05, group = grpR)
minStopTicks = input.int(2,   "Minimum stop distance (ticks)", minval = 0,   group = grpR)
exitOnOpp    = input.bool(true, "Exit on opposite breakout signal", group = grpR)

grpS = "Session (exchange time)"
tradeSess = input.session("0930-1600", "Trading session",        group = grpS)
useSess   = input.bool(true, "Restrict entries to session",      group = grpS)
useFlat   = input.bool(true, "Flatten before close",             group = grpS)
flatH     = input.int(15, "Flatten hour",   minval = 0, maxval = 23, group = grpS)
flatM     = input.int(55, "Flatten minute", minval = 0, maxval = 59, group = grpS)

grpW = "Webhook (TradersPost)"
webhookOn      = input.bool(true, "Build webhook JSON",                     group = grpW)
symbolOverride = input.string("", "Ticker override (blank = chart symbol)", group = grpW)
qtyWebhook     = input.int(1, "Contracts per webhook", minval = 1,          group = grpW)
useBracket     = input.bool(true, "Include stop/target in entry payload",   group = grpW,
     tooltip = "Adds stopLoss/takeProfit objects so the broker holds a bracket. Verify field names against your TradersPost plan docs.")
sendViaAlertFn = input.bool(false, "Also fire alert() calls",               group = grpW,
     tooltip = "Leave OFF when the alert condition is 'Order fills only'. Turning it on with 'Order fills and alert() function calls' double-sends every order.")

grpX = "Display"
showOR      = input.bool(true, "Draw opening range",  group = grpX)
showFilters = input.bool(true, "Plot VWAP / EMA",     group = grpX)
showLevels  = input.bool(true, "Plot stop / target",  group = grpX)
showStats   = input.bool(true, "Stats table",         group = grpX)

// ───────────────────────────────────────────────────────────────────────────
//  2 · INDICATORS
// ───────────────────────────────────────────────────────────────────────────
atr     = ta.atr(atrLen)
volAvg  = ta.sma(volume, volLen)
vwapVal = ta.vwap(hlc3)
emaVal  = ta.ema(close, emaLen)

// ───────────────────────────────────────────────────────────────────────────
//  3 · OPENING RANGE ENGINE  (exchange timezone)
// ───────────────────────────────────────────────────────────────────────────
var float orHigh    = na
var float orLow     = na
var int   orStart   = na
var bool  orReady   = false
var bool  longDone  = false
var bool  shortDone = false

inOR  = not na(time(timeframe.period, orSess))
newOR = inOR and not inOR[1]

if newOR
    orHigh    := high
    orLow     := low
    orStart   := time
    orReady   := false
    longDone  := false
    shortDone := false

if inOR and not newOR
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)

if not inOR and inOR[1]
    orReady := true

// ───────────────────────────────────────────────────────────────────────────
//  4 · SESSION + OR VALIDITY
// ───────────────────────────────────────────────────────────────────────────
inSess   = not useSess or not na(time(timeframe.period, tradeSess))
flatTs   = timestamp(year, month, dayofmonth, flatH, flatM)
pastFlat = useFlat and not na(flatTs) and time >= flatTs

int maxOrMs = int(maxOrHrs * 60 * 60 * 1000)
orValid  = orReady and not na(orStart) and (time - orStart) <= maxOrMs and inSess
canTrade = inSess and not pastFlat

// ───────────────────────────────────────────────────────────────────────────
//  5 · BREAKOUT + FILTERS
// ───────────────────────────────────────────────────────────────────────────
bool outsideUp   = orValid and close > orHigh
bool outsideDown = orValid and close < orLow

// N consecutive closes outside the range (2 by default)
bool barLong  = true
bool barShort = true
for i = 0 to breakBars - 1
    barLong  := barLong  and outsideUp[i]   == true
    barShort := barShort and outsideDown[i] == true

// Volume: current bar vs its own moving average, optionally both bars
volHot   = volume >= volAvg * volMult
volPass  = useVol and (volBoth ? (volHot and volHot[1] == true) : volHot) or not useVol

// Directional trend filters
vwapLong  = not useVwap or close > vwapVal
vwapShort = not useVwap or close < vwapVal
emaLong   = not useEma  or close > emaVal
emaShort  = not useEma  or close < emaVal

allowLong  = dirMode != "Short only"
allowShort = dirMode != "Long only"

longOK  = barLong  and volPass and vwapLong  and emaLong
shortOK = barShort and volPass and vwapShort and emaShort

longSignal  = longOK  and allowLong  and canTrade and (not onePerSide or not longDone)
shortSignal = shortOK and allowShort and canTrade and (not onePerSide or not shortDone)

// ───────────────────────────────────────────────────────────────────────────
//  6 · RISK ENGINE
// ───────────────────────────────────────────────────────────────────────────
minDist = minStopTicks * syminfo.mintick

longSL  = close - math.max(atr * atrSL, minDist)
longTP  = close + math.max(atr * atrTP, minDist)
shortSL = close + math.max(atr * atrSL, minDist)
shortTP = close - math.max(atr * atrTP, minDist)

// ───────────────────────────────────────────────────────────────────────────
//  7 · WEBHOOK ENGINE
// ───────────────────────────────────────────────────────────────────────────
f_payload(string sym, string action, string sentiment, float stopPx, float tpPx, bool bracket) =>
    string s = '{"ticker":"'     + sym
             + '","action":"'    + action
             + '","sentiment":"' + sentiment
             + '","quantity":'   + str.tostring(qtyWebhook)
             + ',"orderType":"market"'
    if bracket and not na(stopPx) and not na(tpPx)
        s := s + ',"stopLoss":{"stopPrice":' + str.tostring(stopPx, format.mintick) + '}'
        s := s + ',"takeProfit":{"limitPrice":' + str.tostring(tpPx, format.mintick) + '}'
    s := s + '}'
    s

sym = str.length(symbolOverride) > 0 ? symbolOverride : syminfo.ticker

longEntryMsg  = webhookOn ? f_payload(sym, "buy",  "long",  longSL,  longTP,  useBracket) : ""
shortEntryMsg = webhookOn ? f_payload(sym, "sell", "short", shortSL, shortTP, useBracket) : ""
exitLongMsg   = webhookOn ? f_payload(sym, "sell", "long",  na, na, false) : ""
exitShortMsg  = webhookOn ? f_payload(sym, "buy",  "short", na, na, false) : ""

// ───────────────────────────────────────────────────────────────────────────
//  8 · ORDER MANAGEMENT
// ───────────────────────────────────────────────────────────────────────────
var float slLevel = na
var float tpLevel = na

if strategy.position_size == 0 and not longSignal and not shortSignal
    slLevel := na
    tpLevel := na

// Exit on opposite raw breakout when we are not flipping
if exitOnOpp and strategy.position_size > 0 and shortOK and not shortSignal
    strategy.close("Long", comment = "Opp signal", alert_message = exitLongMsg)
if exitOnOpp and strategy.position_size < 0 and longOK and not longSignal
    strategy.close("Short", comment = "Opp signal", alert_message = exitShortMsg)

// Long side
if longSignal and strategy.position_size <= 0
    if strategy.position_size < 0
        strategy.close("Short", comment = "Flip long", alert_message = exitShortMsg)
    strategy.entry("Long", strategy.long, alert_message = longEntryMsg)
    strategy.exit("Long-X", from_entry = "Long",
         stop = longSL, limit = longTP, alert_message = exitLongMsg)
    slLevel   := longSL
    tpLevel   := longTP
    longDone  := true
    if sendViaAlertFn
        alert(longEntryMsg, alert.freq_once_per_bar_close)

// Short side
if shortSignal and strategy.position_size >= 0
    if strategy.position_size > 0
        strategy.close("Long", comment = "Flip short", alert_message = exitLongMsg)
    strategy.entry("Short", strategy.short, alert_message = shortEntryMsg)
    strategy.exit("Short-X", from_entry = "Short",
         stop = shortSL, limit = shortTP, alert_message = exitShortMsg)
    slLevel   := shortSL
    tpLevel   := shortTP
    shortDone := true
    if sendViaAlertFn
        alert(shortEntryMsg, alert.freq_once_per_bar_close)

// Flatten-before-close
flatMsg = webhookOn ? f_payload(sym,
     strategy.position_size > 0 ? "sell" : "buy",
     strategy.position_size > 0 ? "long" : "short", na, na, false) : ""

if pastFlat and strategy.position_size != 0
    strategy.close_all(comment = "EOD flat", alert_message = flatMsg)
    if sendViaAlertFn
        alert(flatMsg, alert.freq_once_per_bar_close)

// ───────────────────────────────────────────────────────────────────────────
//  9 · PLOTS
// ───────────────────────────────────────────────────────────────────────────
pOrH = plot(showOR and orValid ? orHigh : na, "OR High",
     color.new(color.aqua, 0), 1, plot.style_linebr)
pOrL = plot(showOR and orValid ? orLow : na, "OR Low",
     color.new(color.aqua, 0), 1, plot.style_linebr)
fill(pOrH, pOrL, color.new(color.aqua, 92), title = "OR band")

plot(showFilters and useVwap ? vwapVal : na, "VWAP", color.new(color.fuchsia, 0), 1)
plot(showFilters and useEma  ? emaVal  : na, "EMA",  color.new(color.orange,  0), 1)

plot(showLevels ? slLevel : na, "Stop",   color.new(color.red,   0), 1, plot.style_linebr)
plot(showLevels ? tpLevel : na, "Target", color.new(color.green, 0), 1, plot.style_linebr)

plotshape(longSignal,  "Long entry",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.tiny)
plotshape(shortSignal, "Short entry", shape.triangledown, location.abovebar, color.new(color.red,   0), size = size.tiny)

// ───────────────────────────────────────────────────────────────────────────
// 10 · ALERT CONDITIONS (static text, no JSON)
// ───────────────────────────────────────────────────────────────────────────
alertcondition(longSignal,  "Long breakout",  "LONG {{ticker}} @ {{close}}")
alertcondition(shortSignal, "Short breakout", "SHORT {{ticker}} @ {{close}}")
alertcondition(pastFlat and strategy.position_size != 0, "EOD flatten", "FLAT {{ticker}}")

// ───────────────────────────────────────────────────────────────────────────
// 11 · BACKTEST STATS
// ───────────────────────────────────────────────────────────────────────────
var table st = table.new(position.top_right, 2, 6,
     border_width = 1, border_color = color.new(color.gray, 60),
     frame_width  = 1, frame_color  = color.new(color.gray, 60))

if showStats and barstate.islast
    int   trades = strategy.closedtrades
    float gp     = strategy.grossprofit
    float gl     = math.abs(strategy.grossloss)
    float pf     = gl > 0 ? gp / gl : na
    float winPct = trades > 0 ? 100.0 * strategy.wintrades / trades : na

    table.cell(st, 0, 0, "METRIC", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(st, 1, 0, "VALUE",  text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(st, 0, 1, "Net P&L",       text_size = size.small)
    table.cell(st, 1, 1, str.tostring(strategy.netprofit, "#,###.##"), text_size = size.small)
    table.cell(st, 0, 2, "Max DD %",      text_size = size.small)
    table.cell(st, 1, 2, str.tostring(strategy.max_drawdown_percent, "#.##") + "%", text_size = size.small)
    table.cell(st, 0, 3, "Closed trades", text_size = size.small)
    table.cell(st, 1, 3, str.tostring(trades), text_size = size.small)
    table.cell(st, 0, 4, "Win rate",      text_size = size.small)
    table.cell(st, 1, 4, na(winPct) ? "—" : str.tostring(winPct, "#.#") + "%", text_size = size.small)
    table.cell(st, 0, 5, "Profit factor", text_size = size.small)
    table.cell(st, 1, 5, na(pf) ? "—" : str.tostring(pf, "#.##"), text_size = size.small)
